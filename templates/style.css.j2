/* coma.fm Radar — Pearl Broadcast Modernism
   Swiss International Style / Bauhaus / Mid-century editorial */

:root {
  /* Pearl Broadcast Modernism palette */
  --bg:         #F3EBDD;  /* pearl paper */
  --surface:    #EFE6D6;  /* warm ivory */
  --surface-2:  #E6D9C6;  /* dusty cream */
  --text:       #1F2523;  /* graphite */
  --muted:      #6A5F52;  /* muted brown */
  --umber:      #3A3128;  /* deep umber */
  --border:     rgba(31, 37, 35, 0.14);
  --rule:       rgba(31, 37, 35, 0.22);
  --accent:     #D86F32;  /* burnt orange */
  --accent-2:   #2E8C8A;  /* petrol teal */
  --danger:     #A93A32;  /* oxide red */
  --ochre:      #C6A13A;  /* ochre mustard */
  --paper:      #F3EBDD;
  --draft-bg:   rgba(169, 58, 50, 0.07);

  /* Spacing rhythm */
  --sp-xs:  0.25rem;
  --sp-sm:  0.5rem;
  --sp-md:  1rem;
  --sp-lg:  2rem;
  --sp-xl:  3rem;
  --sp-2xl: 4rem;

  /* Typography stacks */
  --font-ui:    -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  --font-text:  Georgia, "Times New Roman", serif;
  --font-label: "Helvetica Neue", Arial, sans-serif;

  /* Grid */
  --max-w: 880px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: var(--font-ui);
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
  min-height: 100vh;
}

a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }

/* ── Layout ─────────────────────────────────────────────────── */

.site-shell,
.container {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 var(--sp-lg) var(--sp-2xl);
}

/* ── Masthead / Header ───────────────────────────────────────── */

.masthead,
.site-header {
  padding: var(--sp-lg) 0 var(--sp-sm);
  margin-bottom: var(--sp-md);
  border-bottom: 2px solid var(--text);
}

.brand-grid,
.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--sp-sm);
  margin-bottom: var(--sp-xs);
}

.brand-mark {
  display: flex;
  align-items: baseline;
  gap: var(--sp-sm);
}

.brand-signal {
  color: var(--accent);
  font-size: 0.85rem;
  line-height: 1;
}

.brand-name {
  font-family: var(--font-label);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--text);
}

.brand-sub {
  font-family: var(--font-label);
  font-size: 0.68rem;
  font-weight: 400;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--muted);
}

.brand-line {
  height: 1px;
  background: var(--text);
  opacity: 0.18;
  margin-bottom: var(--sp-xs);
}

/* ── Language switch ─────────────────────────────────────────── */

.language-switch,
nav {
  display: flex;
  gap: var(--sp-md);
  font-family: var(--font-label);
  font-size: 0.7rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.language-switch a,
nav a { color: var(--muted); text-decoration: none; }

.language-switch a:hover,
nav a:hover { color: var(--text); }

.language-switch a.active,
nav a.active {
  color: var(--accent);
  border-bottom: 1.5px solid var(--accent);
  padding-bottom: 1px;
}

/* ── Nav links ───────────────────────────────────────────────── */

.nav-links {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-lg);
  margin-top: var(--sp-lg);
  font-size: 0.82rem;
  letter-spacing: 0.04em;
}

.nav-links a {
  color: var(--muted);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  padding-bottom: 1px;
}

.nav-links a:hover { color: var(--accent); border-color: var(--accent); }

.back {
  display: inline-block;
  font-family: var(--font-label);
  font-size: 0.76rem;
  letter-spacing: 0.06em;
  color: var(--muted);
  text-decoration: none;
  margin-bottom: var(--sp-md);
}

.back:hover { color: var(--accent); text-decoration: none; }

/* ── Hero — asymmetric modernist landing ─────────────────────── */

.hero {
  padding: var(--sp-xl) 0;
  border-bottom: 1px solid var(--rule);
  margin-bottom: 0;
}

.hero-panel {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: var(--sp-xl);
  align-items: start;
}

.hero-kicker {
  font-family: var(--font-label);
  font-size: 0.65rem;
  font-weight: 400;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: var(--sp-md);
}

.hero-title {
  font-family: var(--font-label);
  font-size: clamp(2.6rem, 7vw, 4.8rem);
  font-weight: 700;
  line-height: 0.96;
  letter-spacing: -0.03em;
  color: var(--text);
  margin-bottom: var(--sp-md);
}

.hero-deck {
  font-family: var(--font-text);
  font-size: 0.97rem;
  color: var(--muted);
  line-height: 1.6;
  max-width: 520px;
  margin-bottom: var(--sp-lg);
  font-style: italic;
}

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-lg);
  font-family: var(--font-label);
  font-size: 0.8rem;
  letter-spacing: 0.06em;
}

.hero-meta a {
  color: var(--text);
  text-decoration: none;
  border-bottom: 1px solid var(--rule);
  padding-bottom: 2px;
}

.hero-meta a:hover { color: var(--accent); border-color: var(--accent); }

/* ── Signal strip — broadcast genre bar ─────────────────────── */

.signal-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  margin: 0 0 var(--sp-xl);
  background: var(--surface);
  overflow: hidden;
}

.signal-token {
  font-family: var(--font-label);
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muted);
  padding: 0.55rem 1.1rem;
  border-right: 1px solid var(--rule);
  white-space: nowrap;
  display: block;
  text-decoration: none;
}

.signal-token:hover {
  color: var(--accent);
  background: var(--surface-2);
  text-decoration: none;
}

/* ── Frequency lines — CSS-only editorial texture ────────────── */

.frequency-lines {
  height: 12px;
  background: repeating-linear-gradient(
    90deg,
    transparent,
    transparent 4px,
    rgba(31, 37, 35, 0.06) 4px,
    rgba(31, 37, 35, 0.06) 5px
  );
  margin: var(--sp-md) 0;
}

/* ── Section titles & rules ──────────────────────────────────── */

.section-title,
.section-heading {
  font-family: var(--font-label);
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: var(--sp-sm);
}

.section-rule {
  border: none;
  border-top: 1px solid var(--rule);
  margin: 0 0 var(--sp-lg);
}

/* ── Program grid / Issue grid — editorial listing ───────────── */

.program-grid,
.issue-grid,
.issue-list { margin: 0; }

.program-card,
.issue-card,
.issue-row {
  display: grid;
  grid-template-columns: 7.2rem 1fr auto;
  align-items: baseline;
  gap: 0 var(--sp-md);
  padding: 0.65rem 0;
  border-bottom: 1px solid var(--border);
}

.issue-card-date,
.issue-date {
  font-family: var(--font-label);
  font-size: 0.78rem;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.04em;
  color: var(--accent);
  flex-shrink: 0;
}

.issue-card-title,
.issue-link {
  font-size: 0.9rem;
  color: var(--text);
  text-decoration: none;
  line-height: 1.35;
}

.issue-card-title:hover,
.issue-link:hover { color: var(--accent); text-decoration: none; }

.issue-card-meta,
.issue-meta {
  font-family: var(--font-label);
  font-size: 0.7rem;
  color: var(--muted);
  letter-spacing: 0.04em;
  white-space: nowrap;
}

/* ── Archive index — printed transmission log ────────────────── */

.archive-index,
.archive-list { margin: 0; }

.archive-row,
.archive-item {
  display: grid;
  grid-template-columns: 7.2rem 1fr auto;
  align-items: baseline;
  gap: 0 var(--sp-md);
  padding: 0.65rem 0;
  border-bottom: 1px solid var(--border);
}

.archive-date {
  font-family: var(--font-label);
  font-size: 0.78rem;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.04em;
  color: var(--accent);
  flex-shrink: 0;
}

.archive-link {
  font-size: 0.9rem;
  color: var(--text);
  text-decoration: none;
  line-height: 1.35;
}

.archive-link:hover { color: var(--accent); text-decoration: none; }

.archive-meta {
  font-family: var(--font-label);
  font-size: 0.7rem;
  color: var(--muted);
  letter-spacing: 0.04em;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 0.3rem;
}

/* ── Issue layout — magazine spread / transmission sheet ─────── */

.issue-layout { }

.issue-hero {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: var(--sp-xl);
  margin-bottom: var(--sp-xl);
  align-items: start;
  padding: var(--sp-lg) 0;
  border-bottom: 1px solid var(--rule);
}

.issue-meta-panel {
  padding: var(--sp-md);
  background: var(--surface);
  border-left: 3px solid var(--accent);
}

.issue-meta-panel .issue-date-label {
  display: block;
  margin-bottom: var(--sp-sm);
}

/* ── Entry list — numbered editorial rows ─────────────────────── */

.entry-list,
.item-grid { counter-reset: item-counter; }

.entry-card,
.item-card,
.item {
  display: grid;
  grid-template-columns: 2.5rem 1fr;
  gap: 0 var(--sp-md);
  padding: var(--sp-lg) 0;
  border-bottom: 1px solid var(--border);
  align-items: start;
  counter-increment: item-counter;
}

.entry-number,
.item-number {
  font-family: var(--font-label);
  font-size: 0.65rem;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.06em;
  color: var(--muted);
  padding-top: 0.22rem;
  text-align: right;
  user-select: none;
}

.entry-number::before,
.item-number::before {
  content: counter(item-counter, decimal-leading-zero);
}

.item-body { min-width: 0; }

.entry-title,
.item-title,
.item-card h2,
.item-card h3,
.item h2,
.item h3 {
  font-size: 0.97rem;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 0.3rem;
}

.entry-title a,
.item-title a,
.item-card h2 a,
.item-card h3 a,
.item h2 a,
.item h3 a {
  color: var(--text);
  text-decoration: none;
}

.entry-title a:hover,
.item-title a:hover,
.item-card h2 a:hover,
.item-card h3 a:hover,
.item h2 a:hover,
.item h3 a:hover {
  color: var(--accent);
}

.entry-source,
.item-meta,
.meta {
  font-family: var(--font-label);
  font-size: 0.74rem;
  color: var(--muted);
  margin-bottom: 0.35rem;
  line-height: 1.4;
}

.score { color: var(--accent-2); }
.source { color: var(--muted); }
.artists { font-size: 0.82rem; color: var(--accent); margin-bottom: 0.3rem; }

/* ── Tag list & pills ────────────────────────────────────────── */

.tag-list,
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.3rem;
  margin-top: 0.4rem;
}

.tag-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  padding: var(--sp-sm) 0;
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  margin: var(--sp-md) 0;
}

.tag-pill,
.tag,
.related-tag {
  font-family: var(--font-label);
  background: var(--surface);
  color: var(--muted);
  border: 1px solid var(--border);
  font-size: 0.68rem;
  padding: 0.1rem 0.42rem;
  letter-spacing: 0.06em;
  text-decoration: none;
  display: inline-block;
  transition: color 0.12s, border-color 0.12s;
}

.tag-pill:hover,
.tag:hover,
.related-tag:hover {
  color: var(--accent);
  border-color: var(--accent);
  background: var(--surface-2);
  text-decoration: none;
}

/* ── Tag dossier — signal dossier page ───────────────────────── */

.tag-dossier { }

.tag-page { }

.tag-type {
  font-family: var(--font-label);
  font-size: 0.65rem;
  font-weight: 400;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--accent-2);
  margin-top: 0.3rem;
}

.tag-description {
  font-family: var(--font-text);
  color: var(--muted);
  font-size: 0.9rem;
  margin-top: var(--sp-sm);
  font-style: italic;
}

.related-section { margin: var(--sp-lg) 0; }

.related-section h2,
.items-section h2 {
  font-family: var(--font-label);
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: var(--sp-sm);
}

.related-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }

/* ── Taxonomy board — tag index ──────────────────────────────── */

.taxonomy-board { }

.taxonomy-module,
.group { margin-bottom: var(--sp-xl); }

.group-heading {
  font-family: var(--font-label);
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--muted);
  border-bottom: 1px solid var(--rule);
  padding-bottom: var(--sp-xs);
  margin-bottom: var(--sp-md);
}

/* ── Tag grid ────────────────────────────────────────────────── */

.tag-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(175px, 1fr));
  gap: 0.55rem;
}

.tag-card {
  border: 1px solid var(--border);
  padding: 0.65rem var(--sp-md);
  background: var(--surface);
}

.tag-card a {
  font-family: var(--font-label);
  font-weight: 600;
  font-size: 0.84rem;
  color: var(--text);
  text-decoration: none;
  letter-spacing: 0.02em;
}

.tag-card a:hover { color: var(--accent); text-decoration: none; }

.tag-count {
  font-family: var(--font-label);
  font-size: 0.68rem;
  color: var(--accent-2);
  letter-spacing: 0.06em;
  margin-top: 0.15rem;
}

.tag-desc {
  font-size: 0.74rem;
  color: var(--muted);
  margin-top: 0.22rem;
  line-height: 1.4;
}

/* ── Issue page specifics ────────────────────────────────────── */

.issue-header { margin-bottom: var(--sp-lg); }

.issue-date-label {
  font-family: var(--font-label);
  font-size: 0.8rem;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.08em;
  color: var(--accent);
  margin-top: 0.3rem;
}

.intro {
  font-family: var(--font-text);
  color: var(--muted);
  font-size: 0.9rem;
  font-style: italic;
  margin-top: 0.4rem;
}

.site-title,
h1 {
  font-size: 1.55rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text);
}

.site-description,
.tagline {
  font-family: var(--font-text);
  color: var(--muted);
  font-size: 0.9rem;
  margin-top: 0.4rem;
  font-style: italic;
}

/* ── Badges ──────────────────────────────────────────────────── */

.badge-draft {
  font-family: var(--font-label);
  font-size: 0.62rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: rgba(169, 58, 50, 0.10);
  color: var(--danger);
  border: 1px solid rgba(169, 58, 50, 0.22);
  padding: 0.08rem 0.38rem;
  margin-left: 0.35rem;
}

.badge-published {
  font-family: var(--font-label);
  font-size: 0.62rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: rgba(46, 140, 138, 0.10);
  color: var(--accent-2);
  border: 1px solid rgba(46, 140, 138, 0.22);
  padding: 0.08rem 0.38rem;
  margin-left: 0.35rem;
}

.draft-notice {
  display: inline-block;
  font-family: var(--font-label);
  font-size: 0.64rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  background: rgba(169, 58, 50, 0.08);
  color: var(--danger);
  border: 1px solid rgba(169, 58, 50, 0.20);
  padding: 0.18rem 0.55rem;
  margin-bottom: var(--sp-md);
}

/* ── Issue cover ─────────────────────────────────────────────── */

.cover-frame {
  overflow: hidden;
}

.issue-cover {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto;
}

/* ── Empty states ────────────────────────────────────────────── */

.no-items,
.no-issues {
  font-family: var(--font-text);
  color: var(--muted);
  font-style: italic;
  padding: var(--sp-xl) 0;
  font-size: 0.9rem;
}

/* ── Footer ──────────────────────────────────────────────────── */

.footer,
footer {
  border-top: 2px solid var(--text);
  margin-top: var(--sp-xl);
  padding-top: var(--sp-md);
  font-family: var(--font-label);
  font-size: 0.7rem;
  letter-spacing: 0.06em;
  color: var(--muted);
}

.footer a { color: var(--muted); text-decoration: none; }
.footer a:hover { color: var(--accent); }

/* ── Responsive ──────────────────────────────────────────────── */

@media (max-width: 600px) {
  .site-shell,
  .container { padding: 0 var(--sp-md) var(--sp-xl); }
  .hero-title { font-size: 2.4rem; }
  .hero-panel { grid-template-columns: 1fr; }
  .issue-hero { grid-template-columns: 1fr; }
  .program-card,
  .issue-card,
  .issue-row,
  .archive-row,
  .archive-item { grid-template-columns: 1fr; gap: 0.18rem; padding: 0.6rem 0; }
  .issue-card-date,
  .archive-date { font-size: 0.72rem; }
  .entry-card,
  .item-card,
  .item { grid-template-columns: 1.6rem 1fr; gap: 0 var(--sp-sm); }
  .tag-grid { grid-template-columns: 1fr 1fr; }
  .signal-strip { gap: 0; }
}
