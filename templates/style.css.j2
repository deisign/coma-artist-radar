/* coma.fm Radar — warm nocturnal editorial design system */
:root {
  --bg: #17130f;
  --surface: #211a15;
  --surface-2: #2a211a;
  --text: #f2e6d0;
  --muted: #b8a98e;
  --border: rgba(242, 230, 208, 0.16);
  --accent: #e07a3f;
  --accent-2: #3a8c8c;
  --danger: #b6463a;
  --paper: #f2e6d0;
  --draft-bg: #3a1a18;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Georgia, serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.65;
  padding: 0 1rem 4rem;
}

a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }

/* Layout */

.site-shell,
.container {
  max-width: 760px;
  margin: 0 auto;
}

/* Header */

.site-header,
header {
  padding: 2rem 0 1.5rem;
  border-bottom: 1px solid var(--border);
  margin-bottom: 2rem;
}

.site-title,
h1 {
  font-size: 1.8rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text);
}

.site-description,
.tagline {
  color: var(--muted);
  font-size: 0.95rem;
  margin-top: 0.5rem;
  font-style: italic;
}

/* Language switch */

.language-switch,
nav {
  display: flex;
  gap: 1rem;
  margin-bottom: 1rem;
  font-size: 0.8rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.language-switch a,
nav a { color: var(--muted); }

.language-switch a.active,
nav a.active { color: var(--accent); }

/* Section headings */

.section-heading {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--muted);
  border-bottom: 1px solid var(--border);
  padding-bottom: 0.4rem;
  margin: 2rem 0 1rem;
}

/* Navigation */

.nav-links {
  margin-top: 2rem;
  display: flex;
  gap: 1.5rem;
  font-size: 0.9rem;
}

.back {
  font-size: 0.85rem;
  margin-bottom: 0.8rem;
  display: block;
}

/* Issue & archive lists */

.issue-list,
.archive-list { margin-top: 0; }

.issue-card,
.issue-row {
  display: flex;
  align-items: baseline;
  gap: 1rem;
  padding: 0.65rem 0;
  border-bottom: 1px solid var(--border);
}

.issue-date {
  color: var(--accent);
  font-size: 0.9rem;
  font-variant-numeric: tabular-nums;
  min-width: 7rem;
  flex-shrink: 0;
}

.issue-link { color: var(--text); font-size: 0.9rem; flex: 1; }
.issue-link:hover { color: var(--accent); }
.issue-meta { font-size: 0.8rem; color: var(--muted); white-space: nowrap; }

/* Badges */

.badge-draft {
  font-size: 0.7rem;
  background: var(--draft-bg);
  color: #ffcece;
  padding: 0.1rem 0.4rem;
  border-radius: 3px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin-left: 0.4rem;
}

.badge-published {
  font-size: 0.7rem;
  background: #112820;
  color: var(--accent-2);
  padding: 0.1rem 0.4rem;
  border-radius: 3px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin-left: 0.35rem;
}

/* Draft notice (issue page) */

.draft-notice {
  display: inline-block;
  background: var(--danger);
  color: #ffe8e8;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 0.2rem 0.6rem;
  border-radius: 3px;
  margin-bottom: 0.8rem;
}

/* Item cards */

.item-card,
.item {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 5px;
  padding: 1.25rem 1.4rem;
  margin-bottom: 1.2rem;
}

.item-card h2, .item h2,
.item-card h3, .item h3 {
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 0.4rem;
}

.item-card h2 a, .item h2 a,
.item-card h3 a, .item h3 a { color: var(--text); }

.item-card h2 a:hover, .item h2 a:hover,
.item-card h3 a:hover, .item h3 a:hover { color: var(--accent); text-decoration: none; }

/* Meta / score / source */

.meta { font-size: 0.8rem; color: var(--muted); margin-bottom: 0.5rem; }
.meta .score,
.score { color: var(--accent-2); }
.source { color: var(--muted); }
.artists { font-size: 0.85rem; color: var(--accent); margin-bottom: 0.4rem; }

/* Tag list & pills */

.tag-list,
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.3rem;
  margin-top: 0.5rem;
}

.tag-pill,
.tag,
.related-tag {
  background: var(--surface-2);
  color: var(--muted);
  border: 1px solid var(--border);
  border-radius: 3px;
  font-size: 0.75rem;
  padding: 0.15rem 0.5rem;
  letter-spacing: 0.03em;
}

.tag-pill:hover,
.tag:hover,
.related-tag:hover { color: var(--accent); border-color: var(--accent); text-decoration: none; }

/* Tag page */

.tag-page { }

.tag-type {
  color: var(--muted);
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-top: 0.3rem;
}

.tag-description {
  color: var(--muted);
  font-size: 0.9rem;
  margin-top: 0.6rem;
  font-style: italic;
}

.related-section { margin: 1.5rem 0; }

.related-section h2 {
  font-size: 0.8rem;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 0.6rem;
}

.related-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }

.items-section h2 {
  font-size: 0.8rem;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 1rem;
}

/* Tag grid (tags index) */

.tag-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 0.8rem;
}

.tag-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 5px;
  padding: 0.8rem 1rem;
}

.tag-card a { color: var(--text); font-weight: 600; font-size: 0.9rem; }
.tag-card a:hover { color: var(--accent); text-decoration: none; }
.tag-count { font-size: 0.75rem; color: var(--accent-2); margin-top: 0.2rem; }
.tag-desc { font-size: 0.78rem; color: var(--muted); margin-top: 0.3rem; line-height: 1.4; }

/* Group sections (tag index) */

.group { margin-bottom: 2.5rem; }

.group-heading {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--muted);
  border-bottom: 1px solid var(--border);
  padding-bottom: 0.4rem;
  margin-bottom: 1rem;
}

/* Issue page specifics */

.issue-date-label { color: var(--muted); font-size: 0.85rem; margin-top: 0.3rem; }

.intro {
  color: var(--muted);
  font-size: 0.9rem;
  margin-top: 0.5rem;
  font-style: italic;
}

/* Empty states */

.no-items { color: var(--muted); font-style: italic; padding: 2rem 0; }
.no-issues { color: var(--muted); font-style: italic; padding: 1.5rem 0; }

/* Footer */

.footer,
footer {
  border-top: 1px solid var(--border);
  margin-top: 3rem;
  padding-top: 1.2rem;
  font-size: 0.8rem;
  color: var(--muted);
}

/* Responsive */

@media (max-width: 600px) {
  .issue-card,
  .issue-row { flex-wrap: wrap; gap: 0.4rem; }
  .issue-date { min-width: auto; }
  .tag-grid { grid-template-columns: 1fr 1fr; }
}
