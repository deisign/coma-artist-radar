<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="stylesheet" href="{{ asset_path }}/style.css">
</head>
<body>
<div class="site-shell">
  <header class="masthead site-header">
    <div class="brand-grid header-row">
      <div class="brand-mark">
        <span class="brand-signal">&#9673;</span>
        <span class="brand-name">coma.fm</span>
        <span class="brand-sub">Radar</span>
      </div>
      <nav class="language-switch">
        <a href="{{ nav_en_href }}" {% if lang == "en" %}class="active"{% endif %}>EN</a>
        <a href="{{ nav_uk_href }}" {% if lang == "uk" %}class="active"{% endif %}>UK</a>
      </nav>
    </div>
  </header>

  <main class="issue-layout">
    {% if draft %}
    <div class="draft-notice">{{ draft_notice }}</div>
    {% endif %}

    <div class="issue-hero">
      {% if cover_image_url %}
      <div class="cover-frame">
        <img class="issue-cover" src="{{ cover_image_url }}" alt="{{ cover_alt }}">
      </div>
      {% endif %}
      <div class="issue-meta-panel">
        <h1 class="site-title">{{ heading }}</h1>
        <p class="issue-date-label issue-date">{{ issue_date }}</p>
        <p class="intro">{{ intro }}</p>
      </div>
    </div>

    {% if items %}
    <div class="entry-list item-grid">
      {% for item in items %}
      <article class="entry-card item item-card">
        <span class="entry-number item-number"></span>
        <div class="item-body">
          <h2 class="entry-title item-title"><a href="{{ item.url }}" rel="noopener noreferrer">{{ item.title }}</a></h2>
          <p class="entry-source item-meta meta">
            <span class="source">{{ item.source_name }}</span>
            {% if item.published_at %}
            &middot; <span class="date">{{ item.published_at }}</span>
            {% endif %}
            &middot; <span class="score">{{ item.score }}</span>
          </p>
          {% if item.matched_artists %}
          <p class="artists">{{ item.matched_artists }}</p>
          {% endif %}
          {% if item.tags %}
          <div class="tag-list tags">
            {% for tag in item.tags %}
            <a href="{{ tag_href_prefix }}/{{ tag.slug }}.html" class="tag tag-pill">{{ tag.label }}</a>
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <p class="no-items">{{ no_items_message }}</p>
    {% endif %}
  </main>

  <footer class="footer">
    <p>coma.fm Radar &middot; {{ issue_date }}</p>
  </footer>
</div>
</body>
</html>
