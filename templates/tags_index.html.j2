<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ heading }} — {{ site_heading }}</title>
  <link rel="stylesheet" href="{{ asset_path }}/style.css">
</head>
<body>
<div class="page site-shell">

  <header class="masthead site-header">
    <div class="brand-mark brand-grid">
      <span class="brand-name">coma.fm</span>
      <span class="brand-sub muted">Radar</span>
    </div>
    <nav class="lang language-switch">
      <a href="{{ nav_en_href }}" {% if lang == "en" %}class="active"{% endif %}>EN</a>
      <a href="{{ nav_uk_href }}" {% if lang == "uk" %}class="active"{% endif %}>UK</a>
    </nav>
  </header>

  <main>

    <section class="hero compact">
      <div>
        <div class="kicker hero-kicker">Signal taxonomy</div>
        <h1 class="hero-title md">{{ heading }}</h1>
      </div>
      <aside class="hero-panel atmospheric-field">
        <div class="micro-grid">
          <span class="coordinate-mark"></span>
          <span class="tx-code dominant-signal">{{ section_code }}</span>
          <span class="micro-label quiet-meta">NODE {{ archive_node }}</span>
        </div>
        <div class="ghost-trace"></div>
        <h2>Classification board</h2>
        <p>Canonical genre, aesthetic and editorial tags used across coma.fm Radar.</p>
      </aside>
    </section>

    <div class="taxonomy-board signal-noise">
      {% for group in groups %}
      <div class="taxonomy-module group">
        <h2 class="group-heading">{{ group.type_label }}</h2>
        <div class="taxonomy-list tag-grid">
          {% for tag in group.tags %}
          <a href="{{ tag.href }}" class="tag-pill">{{ tag.label }}</a>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>

  </main>

  <footer class="footer">
    <span>{{ site_heading }}</span>
    <span>Signal Taxonomy</span>
  </footer>

</div>
</body>
</html>
