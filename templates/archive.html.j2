<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="{{ asset_path }}/style.css">
</head>
<body>
<div class="page site-shell">

  <header class="masthead site-header">
    <div class="brand-mark brand-grid">
      <span class="brand-name">coma.fm</span>
      <span class="brand-sub muted">Radar</span>
    </div>
    <nav class="lang language-switch">
      <a href="{{ nav_en_href }}" {% if lang == "en" %}class="active"{% endif %}>EN</a>
      <a href="{{ nav_uk_href }}" {% if lang == "uk" %}class="active"{% endif %}>UK</a>
    </nav>
  </header>

  <main>

    <section class="hero compact">
      <div>
        <div class="kicker hero-kicker">Archive / Transmission Log</div>
        <h1 class="hero-title md">{{ heading }}</h1>
      </div>
      <aside class="hero-panel">
        <h2>Transmission log</h2>
        <p>Published and drafted field reports from the coma.fm signal archive.</p>
        <div class="quick-links">
          <a href="{{ back_href }}">{{ back_label }}</a>
        </div>
      </aside>
    </section>

    <section>
      <div class="section-head section-rule">
        <h2 class="section-title">
          {% if lang == "uk" %}Індекс випусків{% else %}Issue index{% endif %}
        </h2>
      </div>
      <hr class="section-rule" style="display:none">

      <div class="archive-index archive-list">
        {% if issues %}
        {% for issue in issues %}
        <div class="archive-row archive-item">
          <div class="archive-date">{{ issue.date }}</div>
          <div class="archive-title">
            <a class="archive-link issue-link" href="{{ issue.href }}">{{ issue.title }}</a>
          </div>
          <div>{{ issue.item_count }} {{ items_label }}</div>
          <div>{% if issue.draft %}{{ status_draft }}{% else %}{{ status_published }}{% endif %}</div>
          <div><a href="{{ issue.href }}">EN / UK →</a></div>
        </div>
        {% endfor %}
        {% else %}
        <p class="no-issues">{{ no_issues_msg }}</p>
        {% endif %}
      </div>
    </section>

  </main>

  <footer class="footer">
    <span>coma.fm Radar</span>
    <span>Transmission Log</span>
  </footer>

</div>
</body>
</html>
