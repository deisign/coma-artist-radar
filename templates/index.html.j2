<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="stylesheet" href="{{ asset_path }}/style.css">
</head>
<body>
<div class="container site-shell">
  <header class="site-header">
    <nav class="language-switch">
      <a href="{{ nav_en_href }}" {% if lang == "en" %}class="active"{% endif %}>EN</a>
      <a href="{{ nav_uk_href }}" {% if lang == "uk" %}class="active"{% endif %}>UK</a>
    </nav>
    <h1 class="site-title">{{ title }}</h1>
    <p class="site-description tagline">{{ description }}</p>
  </header>

  <main>
    <h2 class="section-heading">{{ latest_issues_heading }}</h2>
    <div class="issue-list">
      {% if issues %}
      {% for issue in issues %}
      <div class="issue-card issue-row">
        <span class="issue-date">{{ issue.date }}</span>
        <a class="issue-link" href="{{ issue.href }}">{{ issue.title }}</a>
        <span class="issue-meta">{{ issue.item_count }}{% if issue.draft %}<span class="badge-draft">draft</span>{% endif %}</span>
      </div>
      {% endfor %}
      {% else %}
      <p class="no-issues">{{ no_issues_msg }}</p>
      {% endif %}
    </div>

    <div class="nav-links">
      <a href="{{ archive_href }}">{{ archive_label }}</a>
      <a href="{{ tags_href }}">{{ tags_label }}</a>
    </div>
  </main>

  <footer class="footer">
    <p>coma.fm Radar</p>
  </footer>
</div>
</body>
</html>
