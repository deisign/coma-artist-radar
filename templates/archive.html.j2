<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="{{ asset_path }}/style.css">
</head>
<body>
<div class="container site-shell">
  <header class="site-header">
    <nav class="language-switch">
      <a href="{{ nav_en_href }}" {% if lang == "en" %}class="active"{% endif %}>EN</a>
      <a href="{{ nav_uk_href }}" {% if lang == "uk" %}class="active"{% endif %}>UK</a>
    </nav>
    <a class="back" href="{{ back_href }}">{{ back_label }}</a>
    <h1 class="site-title">{{ heading }}</h1>
  </header>

  <main>
    <div class="archive-list">
      {% if issues %}
      {% for issue in issues %}
      <div class="issue-card issue-row">
        <span class="issue-date">{{ issue.date }}</span>
        <a class="issue-link" href="{{ issue.href }}">{{ issue.title }}</a>
        <span class="issue-meta">{{ issue.item_count }} {{ items_label }}{% if issue.draft %}<span class="badge-draft">{{ status_draft }}</span>{% else %}<span class="badge-published">{{ status_published }}</span>{% endif %}</span>
      </div>
      {% endfor %}
      {% else %}
      <p class="no-issues">{{ no_issues_msg }}</p>
      {% endif %}
    </div>
  </main>

  <footer class="footer">
    <p>coma.fm Radar</p>
  </footer>
</div>
</body>
</html>
