<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="stylesheet" href="{{ asset_path }}/style.css">
</head>
<body>
<div class="page site-shell">

  <header class="masthead site-header">
    <div class="brand-mark brand-grid">
      <span class="brand-name">coma.fm</span>
      <span class="brand-sub muted">Radar</span>
    </div>
    <nav class="lang language-switch">
      <a href="{{ nav_en_href }}" {% if lang == "en" %}class="active"{% endif %}>EN</a>
      <a href="{{ nav_uk_href }}" {% if lang == "uk" %}class="active"{% endif %}>UK</a>
    </nav>
  </header>

  <main class="issue-layout">

    {% if draft %}
    <div class="draft-notice">{{ draft_notice }}</div>
    {% endif %}

    <section class="issue-hero">
      {% if cover_image_url %}
      <div class="cover-frame issue-cover-large">
        <img class="issue-cover" src="{{ cover_image_url }}" alt="{{ cover_alt }}">
        <div class="cover-meta">
          <span class="cover-code">{{ tx_code }}</span>
          <span class="cover-band">BAND {{ band }}</span>
          <span class="cover-node">NODE {{ archive_node }}</span>
        </div>
      </div>
      {% endif %}
      <aside class="issue-meta-panel">
        <div class="micro-grid">
          <span class="coordinate-mark"></span>
          <span class="tx-code dominant-signal">{{ tx_code }}</span>
          <span class="micro-label quiet-meta">BAND {{ band }}</span>
          <span class="micro-label">SIGNALS {{ signal_count }}</span>
          <span class="micro-label quiet-meta">NODE {{ archive_node }}</span>
        </div>
        {% if field_tags_label %}
        <div class="field-tags">{{ field_tags_label }}</div>
        {% endif %}
        <div class="kicker">coma.fm Radar / Field Report</div>
        <h1 class="issue-title">{{ issue_date }}<br><span class="issue-date">{{ heading }}</span></h1>
        <div class="transmission-block">
          <p class="tx-summary">{{ tx_summary }}</p>
        </div>
        <div class="meta-grid">
          <span>Date</span><strong>{{ issue_date }}</strong>
          <span>Lang</span><strong>{{ lang_label }}</strong>
          <span>Signals</span><strong>{{ signal_count }}</strong>
          <span>Status</span><strong>{% if draft %}Draft{% else %}Active{% endif %}</strong>
        </div>
      </aside>
    </section>

    <div class="relay-line"></div>

    <section>
      <div class="section-head section-rule">
        <h2 class="section-title">
          {% if lang == "uk" %}В цьому випуску{% else %}In this issue{% endif %}
        </h2>
      </div>
      <hr class="section-rule" style="display:none">

      {% if items %}
      <div class="entry-list item-grid">
        {% for item in items %}
        <article class="entry-card item item-card">
          <div class="entry-number item-number">{{ item.index }}</div>
          <div class="item-body">
            {% if item.matched_artists %}
            <div class="entry-kicker">{{ item.matched_artists }}</div>
            {% endif %}
            <h2 class="entry-title item-title">
              <a href="{{ item.url }}" rel="noopener noreferrer">{{ item.title }}</a>
            </h2>
            <div class="entry-source item-meta meta">
              <span class="source">{{ item.source_name }}</span>
              {% if item.published_at %}&middot; <span class="date">{{ item.published_at }}</span>{% endif %}
              &middot; <span class="score">{{ item.score }}</span>
            </div>
            {% if item.tags %}
            <div class="tag-line tag-list tags">
              {% for tag in item.tags %}
              <a href="{{ tag_href_prefix }}/{{ tag.slug }}.html" class="tag tag-pill">{{ tag.label }}</a>
              {% endfor %}
            </div>
            {% endif %}
          </div>
          <div class="entry-score">
            <a href="{{ item.url }}" rel="noopener noreferrer">{{ item.score }} →</a>
          </div>
        </article>
        {% endfor %}
      </div>
      {% else %}
      <p class="no-items">{{ no_items_message }}</p>
      {% endif %}
    </section>

  </main>

  <footer class="footer">
    <span>coma.fm Radar</span>
    <span>{{ issue_date }}</span>
  </footer>

</div>
</body>
</html>
