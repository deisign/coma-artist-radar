<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="900" height="1125" viewBox="0 0 900 1125">

  <!-- Background: pearl paper -->
  <rect width="900" height="1125" fill="#F3EBDD"/>

  <!-- Paper texture: column grid lines -->
  <line x1="0" y1="0" x2="0" y2="1125" stroke="#1F2523" stroke-width="1" opacity=".04"/>
  <line x1="150" y1="0" x2="150" y2="1125" stroke="#1F2523" stroke-width="1" opacity=".04"/>
  <line x1="300" y1="0" x2="300" y2="1125" stroke="#1F2523" stroke-width="1" opacity=".04"/>
  <line x1="450" y1="0" x2="450" y2="1125" stroke="#1F2523" stroke-width="1" opacity=".04"/>
  <line x1="600" y1="0" x2="600" y2="1125" stroke="#1F2523" stroke-width="1" opacity=".04"/>
  <line x1="750" y1="0" x2="750" y2="1125" stroke="#1F2523" stroke-width="1" opacity=".04"/>
  <line x1="900" y1="0" x2="900" y2="1125" stroke="#1F2523" stroke-width="1" opacity=".04"/>

  <!-- Motif dispatch -->
  {% if motif == "reverb_wave" %}
  <path d="M-60,400 Q225,300 450,400 Q675,500 900,400 Q1125,300 1320,400"
        fill="none" stroke="{{ accent }}" stroke-width="3" opacity=".35"/>
  <path d="M-60,500 Q225,400 450,500 Q675,600 900,500 Q1125,400 1320,500"
        fill="none" stroke="{{ accent }}" stroke-width="2" opacity=".25"/>
  <path d="M-60,600 Q225,500 450,600 Q675,700 900,600 Q1125,500 1320,600"
        fill="none" stroke="#6A5F52" stroke-width="1" opacity=".18"/>
  {% endif %}

  {% if motif == "dusty_vinyl" %}
  <circle cx="450" cy="560" r="320" fill="none" stroke="#6A5F52" stroke-width="1.5" opacity=".22"/>
  <circle cx="450" cy="560" r="260" fill="none" stroke="#6A5F52" stroke-width="1"   opacity=".18"/>
  <circle cx="450" cy="560" r="200" fill="none" stroke="#6A5F52" stroke-width="1.5" opacity=".22"/>
  <circle cx="450" cy="560" r="140" fill="none" stroke="#6A5F52" stroke-width="1"   opacity=".18"/>
  <circle cx="450" cy="560" r="90"  fill="none" stroke="#6A5F52" stroke-width="1.5" opacity=".22"/>
  <circle cx="450" cy="560" r="44"  fill="{{ accent }}" opacity=".22"/>
  <circle cx="450" cy="560" r="18"  fill="#F3EBDD" opacity=".90"/>
  {% endif %}

  {% if motif == "lacquer_graves" %}
  <rect x="80"  y="380" width="80"  height="180" rx="0" fill="{{ accent }}"   opacity=".18"/>
  <rect x="200" y="320" width="100" height="240" rx="0" fill="{{ accent_2 }}" opacity=".14"/>
  <rect x="340" y="360" width="70"  height="200" rx="0" fill="{{ accent }}"   opacity=".14"/>
  <path d="M0,820 L250,520 L340,520 L100,820 Z"  fill="{{ accent }}" opacity=".08"/>
  <path d="M100,900 L380,520 L470,520 L190,900 Z" fill="{{ accent }}" opacity=".06"/>
  {% endif %}

  {% if motif == "midnight_window" %}
  {% for y in range(120, 960, 90) %}
  <rect x="0" y="{{ y }}" width="900" height="18" fill="#1F2523" opacity=".045"/>
  {% endfor %}
  {% endif %}

  {% if motif == "desert_twang" %}
  <path d="M0,780 Q225,680 450,750 Q675,820 900,720 L900,1125 L0,1125 Z"
        fill="#E6D9C6" opacity=".65"/>
  <path d="M0,840 Q250,760 520,810 Q780,860 900,800 L900,1125 L0,1125 Z"
        fill="#E6D9C6" opacity=".45"/>
  <circle cx="200" cy="620" r="140" fill="{{ accent }}" opacity=".07"/>
  <circle cx="200" cy="620" r="90"  fill="{{ accent }}" opacity=".07"/>
  {% endif %}

  {% if motif == "atomic_orbit" %}
  <ellipse cx="450" cy="560" rx="360" ry="120" fill="none" stroke="{{ accent }}"
           stroke-width="2" opacity=".28" transform="rotate(-40 450 560)"/>
  <ellipse cx="450" cy="560" rx="360" ry="120" fill="none" stroke="{{ accent }}"
           stroke-width="2" opacity=".28" transform="rotate(40 450 560)"/>
  <ellipse cx="450" cy="560" rx="360" ry="120" fill="none" stroke="{{ accent_2 }}"
           stroke-width="1" opacity=".20"/>
  <circle cx="450" cy="560" r="24" fill="{{ accent }}" opacity=".30"/>
  <circle cx="450" cy="560" r="10" fill="{{ accent }}" opacity=".50"/>
  {% endif %}

  {% if motif == "smoke_signal" %}
  <path d="M270,1060 C260,880 310,780 270,660 C230,540 290,420 270,300 C250,180 284,80 270,0"
        fill="none" stroke="#6A5F52" stroke-width="4" stroke-linecap="round" opacity=".14"/>
  <path d="M180,1060 C200,880 152,780 188,660 C224,540 168,420 212,300 C256,180 208,80 236,0"
        fill="none" stroke="#6A5F52" stroke-width="2.5" stroke-linecap="round" opacity=".09"/>
  {% endif %}

  {% if motif == "radio_tower" %}
  <line x1="270" y1="980" x2="270" y2="140" stroke="#6A5F52" stroke-width="2.5" opacity=".22"/>
  <line x1="90"  y1="980" x2="450" y2="980" stroke="#6A5F52" stroke-width="2.5" opacity=".20"/>
  <line x1="120" y1="840" x2="420" y2="840" stroke="#6A5F52" stroke-width="2"   opacity=".18"/>
  <line x1="150" y1="700" x2="390" y2="700" stroke="#6A5F52" stroke-width="2"   opacity=".16"/>
  <line x1="180" y1="560" x2="360" y2="560" stroke="#6A5F52" stroke-width="1.5" opacity=".14"/>
  <line x1="210" y1="420" x2="330" y2="420" stroke="#6A5F52" stroke-width="1.5" opacity=".12"/>
  <line x1="90"  y1="980" x2="270" y2="140" stroke="#6A5F52" stroke-width="1"   opacity=".12"/>
  <line x1="450" y1="980" x2="270" y2="140" stroke="#6A5F52" stroke-width="1"   opacity=".12"/>
  <circle cx="270" cy="140" r="36"  fill="none" stroke="{{ accent }}" stroke-width="2"   opacity=".38"/>
  <circle cx="270" cy="140" r="72"  fill="none" stroke="{{ accent }}" stroke-width="1"   opacity=".22"/>
  <circle cx="270" cy="140" r="110" fill="none" stroke="{{ accent }}" stroke-width=".5"  opacity=".14"/>
  {% endif %}

  <!-- Horizontal composition rule -->
  <line x1="60" y1="820" x2="840" y2="820" stroke="#1F2523" stroke-width="10"/>

  <!-- Vertical divider -->
  <line x1="450" y1="100" x2="450" y2="760" stroke="#1F2523" stroke-width="3" opacity=".30"/>

  <!-- Accent bar -->
  <rect x="60" y="100" width="5" height="680" fill="{{ accent }}" opacity=".60"/>

  <!-- Masthead: site name -->
  <text x="80" y="170"
        font-family="'Arial Black',Impact,Arial,sans-serif"
        font-size="82" fill="#1F2523" letter-spacing="-3">COMA.FM</text>
  <text x="80" y="256"
        font-family="'Arial Black',Impact,Arial,sans-serif"
        font-size="82" fill="#1F2523" letter-spacing="-3">RADAR</text>

  <!-- Issue date -->
  <text x="80" y="860"
        font-family="Arial,sans-serif"
        font-size="22" fill="{{ accent }}" letter-spacing="5">{{ issue_date }}</text>

  <!-- Main tag label -->
  <rect x="78" y="882" width="{{ tag_pill_width }}" height="40" rx="0"
        fill="{{ accent }}" opacity=".15"/>
  <text x="84" y="910"
        font-family="Arial,sans-serif"
        font-size="18" fill="{{ accent }}" letter-spacing="3" font-weight="700">{{ main_tag_label }}</text>

  <!-- Issue title -->
  <text x="80" y="980"
        font-family="'Arial Black',Impact,Arial,sans-serif"
        font-size="{{ title_font_size }}" fill="#1F2523" letter-spacing="-1">{{ title }}</text>

  {% if subtitle %}
  <text x="80" y="1020"
        font-family="Georgia,serif"
        font-size="22" fill="#6A5F52" font-style="italic">{{ subtitle }}</text>
  {% endif %}

  <!-- Bottom label -->
  <text x="80" y="1085"
        font-family="Arial,sans-serif"
        font-size="22" fill="#6A5F52" letter-spacing="5">FIELD REPORT / SIGNAL ARCHIVE</text>

  <!-- Item count -->
  <text x="80" y="1110"
        font-family="Arial,sans-serif"
        font-size="18" fill="#6A5F52" letter-spacing="2">{{ item_count }} items · {{ lang_label }}</text>

  <!-- Language badge -->
  <rect x="800" y="60" width="64" height="30" rx="0" fill="{{ accent }}" opacity=".18"/>
  <text x="832" y="82"
        font-family="Arial,sans-serif"
        font-size="13" fill="{{ accent }}" font-weight="700" letter-spacing="3"
        text-anchor="middle">{{ lang_label }}</text>

  <!-- Outer registration frame -->
  <rect x="20" y="20" width="860" height="1085" rx="0"
        fill="none" stroke="#6A5F52" stroke-width="1" opacity=".22"/>

  <!-- Corner marks -->
  <line x1="20" y1="20"   x2="56"  y2="20"   stroke="{{ accent }}" stroke-width="2" opacity=".45"/>
  <line x1="20" y1="20"   x2="20"  y2="56"   stroke="{{ accent }}" stroke-width="2" opacity=".45"/>
  <line x1="880" y1="20"  x2="844" y2="20"   stroke="{{ accent }}" stroke-width="2" opacity=".45"/>
  <line x1="880" y1="20"  x2="880" y2="56"   stroke="{{ accent }}" stroke-width="2" opacity=".45"/>
  <line x1="20" y1="1105" x2="56"  y2="1105" stroke="{{ accent }}" stroke-width="2" opacity=".45"/>
  <line x1="20" y1="1105" x2="20"  y2="1069" stroke="{{ accent }}" stroke-width="2" opacity=".45"/>
  <line x1="880" y1="1105" x2="844" y2="1105" stroke="{{ accent }}" stroke-width="2" opacity=".45"/>
  <line x1="880" y1="1105" x2="880" y2="1069" stroke="{{ accent }}" stroke-width="2" opacity=".45"/>

</svg>
