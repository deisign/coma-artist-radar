<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ heading }} — {{ site_heading }}</title>
  <style>
    :root {
      --bg: #161616;
      --fg: #e0ddd8;
      --accent: #c8a46e;
      --accent2: #8ab4a0;
      --subtle: #888;
      --border: #2a2a2a;
      --card: #1e1e1e;
      --tag-bg: #252525;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Georgia, serif;
      background: var(--bg);
      color: var(--fg);
      line-height: 1.65;
      padding: 0 1rem 4rem;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .container { max-width: 760px; margin: 0 auto; }
    header { padding: 2rem 0 1.5rem; border-bottom: 1px solid var(--border); margin-bottom: 2rem; }
    nav { display: flex; gap: 1rem; margin-bottom: 1rem; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; }
    nav a { color: var(--subtle); }
    nav a.active { color: var(--accent); }
    h1 { font-size: 1.5rem; font-weight: 600; letter-spacing: -0.01em; color: var(--fg); }
    .group { margin-bottom: 2.5rem; }
    .group-heading {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--subtle);
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.4rem;
      margin-bottom: 1rem;
    }
    .tag-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.8rem; }
    .tag-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 0.8rem 1rem;
    }
    .tag-card a { color: var(--fg); font-weight: 600; font-size: 0.9rem; }
    .tag-card a:hover { color: var(--accent); text-decoration: none; }
    .tag-count { font-size: 0.75rem; color: var(--accent2); margin-top: 0.2rem; }
    .tag-desc { font-size: 0.78rem; color: var(--subtle); margin-top: 0.3rem; line-height: 1.4; }
    footer { border-top: 1px solid var(--border); margin-top: 3rem; padding-top: 1.2rem; font-size: 0.8rem; color: var(--subtle); }
  </style>
</head>
<body>
<div class="container">
  <header>
    <nav>
      <a href="/en/tags/index.html" {% if lang == "en" %}class="active"{% endif %}>EN</a>
      <a href="/uk/tags/index.html" {% if lang == "uk" %}class="active"{% endif %}>UK</a>
    </nav>
    <h1>{{ heading }}</h1>
  </header>

  <main>
    {% for group in groups %}
    <section class="group">
      <h2 class="group-heading">{{ group.type_label }}</h2>
      <div class="tag-grid">
        {% for tag in group.tags %}
        <div class="tag-card">
          <a href="{{ tag.href }}">{{ tag.label }}</a>
          <p class="tag-count">{{ tag.count }}</p>
          {% if tag.description %}
          <p class="tag-desc">{{ tag.description }}</p>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </section>
    {% endfor %}
  </main>

  <footer>
    <p>{{ site_heading }}</p>
  </footer>
</div>
</body>
</html>
