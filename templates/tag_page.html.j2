<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ tag_label }} — {{ site_heading }}</title>
  <meta name="description" content="{{ tag_description }}">
  <link rel="stylesheet" href="{{ asset_path }}/style.css">
</head>
<body>
<div class="page site-shell">

  <header class="masthead site-header">
    <div class="brand-mark brand-grid">
      <span class="brand-name">coma.fm</span>
      <span class="brand-sub muted">Radar</span>
    </div>
    <nav class="lang language-switch">
      <a href="{{ nav_en_href }}" {% if lang == "en" %}class="active"{% endif %}>EN</a>
      <a href="{{ nav_uk_href }}" {% if lang == "uk" %}class="active"{% endif %}>UK</a>
    </nav>
  </header>

  <main>
    <a class="back" href="{{ back_href }}">{{ back_to_index }}</a>

    <section class="tag-dossier">
      <div>
        <div class="micro-grid">
          <span class="tx-code">{{ section_code }}</span>
          <span class="micro-label">NODE {{ archive_node }}</span>
        </div>
        <div class="kicker hero-kicker">Signal dossier</div>
        <h1 class="dossier-title">{{ tag_label }}</h1>
        {% if tag_type %}
        <div class="tag-type">{{ tag_type }}</div>
        {% endif %}
        {% if tag_description %}
        <p class="dossier-note tag-description">{{ tag_description }}</p>
        {% endif %}
        {% if related_tags %}
        <div class="tag-line tag-strip related-tags">
          {% for related in related_tags %}
          <a href="{{ related.href }}" class="related-tag">{{ related.label }}</a>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      <div class="signal-target"></div>
    </section>

    <section class="items-section">
      <div class="section-head section-rule">
        <h2 class="section-title">{{ items_heading }}</h2>
      </div>
      <hr class="section-rule" style="display:none">

      {% if items %}
      <div class="entry-list item-grid">
        {% for item in items %}
        <article class="entry-card item item-card">
          <div class="entry-number item-number">{{ "%02d"|format(loop.index) }}</div>
          <div class="item-body">
            {% if item.matched_artists %}
            <div class="entry-kicker">{{ item.matched_artists }}</div>
            {% endif %}
            <h3 class="entry-title item-title">
              <a href="{{ item.url }}" rel="noopener noreferrer">{{ item.title }}</a>
            </h3>
            <div class="entry-source item-meta meta">
              <span class="source">{{ item.source_name }}</span>
              {% if item.published_at %}&middot; <span class="date">{{ item.published_at }}</span>{% endif %}
              &middot; <span class="score">{{ item.score }}</span>
              &middot; <a href="{{ item.issue_href }}" class="issue-link">{{ item.issue_date }}</a>
            </div>
          </div>
          <div class="entry-score">
            <a href="{{ item.url }}" rel="noopener noreferrer">{{ item.score }} →</a>
          </div>
        </article>
        {% endfor %}
      </div>
      {% else %}
      <p class="no-items">{{ no_items_message }}</p>
      {% endif %}
    </section>

  </main>

  <footer class="footer">
    <span>{{ site_heading }}</span>
    <span>{{ tag_label }}</span>
  </footer>

</div>
</body>
</html>
