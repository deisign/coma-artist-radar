<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="stylesheet" href="{{ asset_path }}/style.css">
</head>
<body>
<div class="container site-shell">
  <header class="site-header">
    <nav class="language-switch">
      <a href="{{ nav_en_href }}" {% if lang == "en" %}class="active"{% endif %}>EN</a>
      <a href="{{ nav_uk_href }}" {% if lang == "uk" %}class="active"{% endif %}>UK</a>
    </nav>
    {% if draft %}
    <div class="draft-notice">{{ draft_notice }}</div>
    {% endif %}
    <h1 class="site-title">{{ heading }}</h1>
    <p class="issue-date">{{ issue_date }}</p>
    <p class="intro">{{ intro }}</p>
  </header>

  <main>
    {% if cover_image_url %}
    <div class="cover-frame">
      <img class="issue-cover" src="{{ cover_image_url }}" alt="{{ cover_alt }}">
    </div>
    {% endif %}
    {% if items %}
    {% for item in items %}
    <article class="item item-card">
      <h2><a href="{{ item.url }}" rel="noopener noreferrer">{{ item.title }}</a></h2>
      <p class="meta">
        <span class="source">{{ item.source_name }}</span>
        {% if item.published_at %}
        &middot; <span class="date">{{ item.published_at }}</span>
        {% endif %}
        &middot; <span class="score">{{ item.score }}</span>
      </p>
      {% if item.matched_artists %}
      <p class="artists">{{ item.matched_artists }}</p>
      {% endif %}
      {% if item.tags %}
      <p class="tags tag-list">
        {% for tag in item.tags %}
        <a href="{{ tag_href_prefix }}/{{ tag.slug }}.html" class="tag tag-pill">{{ tag.label }}</a>
        {% endfor %}
      </p>
      {% endif %}
    </article>
    {% endfor %}
    {% else %}
    <p class="no-items">{{ no_items_message }}</p>
    {% endif %}
  </main>

  <footer class="footer">
    <p>coma.fm Radar &middot; {{ issue_date }}</p>
  </footer>
</div>
</body>
</html>
