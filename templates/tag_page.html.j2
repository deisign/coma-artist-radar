<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ tag_label }} — {{ site_heading }}</title>
  <meta name="description" content="{{ tag_description }}">
  <style>
    :root {
      --bg: #161616;
      --fg: #e0ddd8;
      --accent: #c8a46e;
      --accent2: #8ab4a0;
      --subtle: #888;
      --border: #2a2a2a;
      --card: #1e1e1e;
      --tag-bg: #252525;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Georgia, serif;
      background: var(--bg);
      color: var(--fg);
      line-height: 1.65;
      padding: 0 1rem 4rem;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .container { max-width: 760px; margin: 0 auto; }
    header { padding: 2rem 0 1.5rem; border-bottom: 1px solid var(--border); margin-bottom: 2rem; }
    nav { display: flex; gap: 1rem; margin-bottom: 1rem; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; }
    nav a { color: var(--subtle); }
    nav a.active { color: var(--accent); }
    .back { font-size: 0.85rem; margin-bottom: 1rem; display: block; }
    h1 { font-size: 1.5rem; font-weight: 600; letter-spacing: -0.01em; color: var(--fg); }
    .tag-type { color: var(--subtle); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; margin-top: 0.3rem; }
    .tag-description { color: var(--subtle); font-size: 0.9rem; margin-top: 0.6rem; font-style: italic; }
    .related-section { margin: 1.5rem 0; }
    .related-section h2 { font-size: 0.8rem; color: var(--subtle); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.6rem; }
    .related-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
    .related-tag {
      background: var(--tag-bg);
      color: var(--subtle);
      border: 1px solid var(--border);
      border-radius: 3px;
      font-size: 0.75rem;
      padding: 0.15rem 0.5rem;
      letter-spacing: 0.03em;
    }
    .related-tag:hover { color: var(--accent); border-color: var(--accent); text-decoration: none; }
    .items-section h2 { font-size: 0.8rem; color: var(--subtle); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem; }
    .item {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 1.25rem 1.4rem;
      margin-bottom: 1.2rem;
    }
    .item h3 { font-size: 1rem; font-weight: 600; line-height: 1.4; margin-bottom: 0.4rem; }
    .item h3 a { color: var(--fg); }
    .item h3 a:hover { color: var(--accent); text-decoration: none; }
    .meta { font-size: 0.8rem; color: var(--subtle); margin-bottom: 0.4rem; }
    .meta .score { color: var(--accent2); }
    .artists { font-size: 0.85rem; color: var(--accent); }
    .no-items { color: var(--subtle); font-style: italic; padding: 2rem 0; }
    footer { border-top: 1px solid var(--border); margin-top: 3rem; padding-top: 1.2rem; font-size: 0.8rem; color: var(--subtle); }
  </style>
</head>
<body>
<div class="container">
  <header>
    <nav>
      <a href="{{ nav_en_href }}" {% if lang == "en" %}class="active"{% endif %}>EN</a>
      <a href="{{ nav_uk_href }}" {% if lang == "uk" %}class="active"{% endif %}>UK</a>
    </nav>
    <a class="back" href="{{ back_href }}">{{ back_to_index }}</a>
    <h1>{{ tag_label }}</h1>
    {% if tag_type %}
    <p class="tag-type">{{ tag_type }}</p>
    {% endif %}
    {% if tag_description %}
    <p class="tag-description">{{ tag_description }}</p>
    {% endif %}
  </header>

  {% if related_tags %}
  <section class="related-section">
    <h2>{{ related_heading }}</h2>
    <div class="related-tags">
      {% for related in related_tags %}
      <a href="{{ related.href }}" class="related-tag">{{ related.label }}</a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="items-section">
    <h2>{{ items_heading }}</h2>
    {% if items %}
    {% for item in items %}
    <article class="item">
      <h3><a href="{{ item.url }}" rel="noopener noreferrer">{{ item.title }}</a></h3>
      <p class="meta">
        <span class="source">{{ item.source_name }}</span>
        {% if item.published_at %}
        &middot; <span class="date">{{ item.published_at }}</span>
        {% endif %}
        &middot; <span class="score">{{ item.score }}</span>
        &middot; <a href="{{ item.issue_href }}">{{ item.issue_date }}</a>
      </p>
      {% if item.matched_artists %}
      <p class="artists">{{ item.matched_artists }}</p>
      {% endif %}
    </article>
    {% endfor %}
    {% else %}
    <p class="no-items">{{ no_items_message }}</p>
    {% endif %}
  </section>

  <footer>
    <p>{{ site_heading }}</p>
  </footer>
</div>
</body>
</html>
