<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="{{ asset_path }}/style.css">
</head>
<body>
<div class="site-shell">
  <header class="masthead site-header">
    <div class="brand-grid header-row">
      <div class="brand-mark">
        <span class="brand-signal">&#9673;</span>
        <span class="brand-name">coma.fm</span>
        <span class="brand-sub">Radar</span>
      </div>
      <nav class="language-switch">
        <a href="{{ nav_en_href }}" {% if lang == "en" %}class="active"{% endif %}>EN</a>
        <a href="{{ nav_uk_href }}" {% if lang == "uk" %}class="active"{% endif %}>UK</a>
      </nav>
    </div>
  </header>

  <main>
    <a class="back" href="{{ back_href }}">{{ back_label }}</a>
    <h1 class="section-title">{{ heading }}</h1>
    <hr class="section-rule">
    <div class="archive-index archive-list">
      {% if issues %}
      {% for issue in issues %}
      <div class="archive-row archive-item">
        <span class="archive-date">{{ issue.date }}</span>
        <a class="archive-link issue-link" href="{{ issue.href }}">{{ issue.title }}</a>
        <span class="archive-meta issue-meta">{{ issue.item_count }} {{ items_label }}{% if issue.draft %}<span class="badge-draft">{{ status_draft }}</span>{% else %}<span class="badge-published">{{ status_published }}</span>{% endif %}</span>
      </div>
      {% endfor %}
      {% else %}
      <p class="no-issues">{{ no_issues_msg }}</p>
      {% endif %}
    </div>
  </main>

  <footer class="footer">
    <p>coma.fm Radar</p>
  </footer>
</div>
</body>
</html>
