<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ heading }} — {{ site_heading }}</title>
  <link rel="stylesheet" href="{{ asset_path }}/style.css">
</head>
<body>
<div class="site-shell">
  <header class="masthead site-header">
    <div class="brand-grid header-row">
      <div class="brand-mark">
        <span class="brand-signal">&#9673;</span>
        <span class="brand-name">coma.fm</span>
        <span class="brand-sub">Radar</span>
      </div>
      <nav class="language-switch">
        <a href="{{ nav_en_href }}" {% if lang == "en" %}class="active"{% endif %}>EN</a>
        <a href="{{ nav_uk_href }}" {% if lang == "uk" %}class="active"{% endif %}>UK</a>
      </nav>
    </div>
  </header>

  <main>
    <h1 class="section-title">{{ heading }}</h1>
    <hr class="section-rule">
    <div class="taxonomy-board">
      {% for group in groups %}
      <section class="taxonomy-module group">
        <h2 class="group-heading">{{ group.type_label }}</h2>
        <div class="tag-grid">
          {% for tag in group.tags %}
          <div class="tag-card">
            <a href="{{ tag.href }}" class="tag-pill">{{ tag.label }}</a>
            <p class="tag-count">{{ tag.count }}</p>
            {% if tag.description %}
            <p class="tag-desc">{{ tag.description }}</p>
            {% endif %}
          </div>
          {% endfor %}
        </div>
      </section>
      {% endfor %}
    </div>
  </main>

  <footer class="footer">
    <p>{{ site_heading }}</p>
  </footer>
</div>
</body>
</html>
