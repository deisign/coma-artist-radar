<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="900" height="1125" viewBox="0 0 900 1125">
  <title>coma.fm Radar &#x2014; {{ issue_date }}</title>

  <!-- Background: pearl paper -->
  <rect width="900" height="1125" fill="#F3EBDD"/>

  <!-- Column grid &#x2014; structural reference, very faint -->
  <line x1="150" y1="0" x2="150" y2="1125" stroke="#1F2523" stroke-width="1" opacity=".028"/>
  <line x1="300" y1="0" x2="300" y2="1125" stroke="#1F2523" stroke-width="1" opacity=".028"/>
  <line x1="450" y1="0" x2="450" y2="1125" stroke="#1F2523" stroke-width="1" opacity=".028"/>
  <line x1="600" y1="0" x2="600" y2="1125" stroke="#1F2523" stroke-width="1" opacity=".028"/>
  <line x1="750" y1="0" x2="750" y2="1125" stroke="#1F2523" stroke-width="1" opacity=".028"/>

  <!-- Outer registration frame -->
  <rect x="24" y="24" width="852" height="1077" rx="0"
        fill="none" stroke="#6A5F52" stroke-width="0.75" opacity=".25"/>

  <!-- Registration marks &#x2014; print cross hairlines at corners -->
  <line x1="24" y1="12" x2="24" y2="36" stroke="#1F2523" stroke-width="0.75" opacity=".38"/>
  <line x1="12" y1="24" x2="36" y2="24" stroke="#1F2523" stroke-width="0.75" opacity=".38"/>
  <circle cx="24" cy="24" r="5" fill="none" stroke="#1F2523" stroke-width="0.75" opacity=".25"/>
  <line x1="876" y1="12" x2="876" y2="36" stroke="#1F2523" stroke-width="0.75" opacity=".38"/>
  <line x1="864" y1="24" x2="888" y2="24" stroke="#1F2523" stroke-width="0.75" opacity=".38"/>
  <circle cx="876" cy="24" r="5" fill="none" stroke="#1F2523" stroke-width="0.75" opacity=".25"/>
  <line x1="24" y1="1089" x2="24" y2="1113" stroke="#1F2523" stroke-width="0.75" opacity=".38"/>
  <line x1="12" y1="1101" x2="36" y2="1101" stroke="#1F2523" stroke-width="0.75" opacity=".38"/>
  <circle cx="24" cy="1101" r="5" fill="none" stroke="#1F2523" stroke-width="0.75" opacity=".25"/>
  <line x1="876" y1="1089" x2="876" y2="1113" stroke="#1F2523" stroke-width="0.75" opacity=".38"/>
  <line x1="864" y1="1101" x2="888" y2="1101" stroke="#1F2523" stroke-width="0.75" opacity=".38"/>
  <circle cx="876" cy="1101" r="5" fill="none" stroke="#1F2523" stroke-width="0.75" opacity=".25"/>

  <!-- Left accent bar -->
  <rect x="60" y="110" width="3" height="690" fill="{{ accent }}" opacity=".50"/>

  <!-- Language badge &#x2014; top right -->
  <rect x="808" y="54" width="58" height="24" rx="0" fill="{{ accent }}" opacity=".12"/>
  <text x="837" y="71"
        font-family="Arial,sans-serif"
        font-size="11" fill="{{ accent }}" font-weight="700" letter-spacing="3"
        text-anchor="middle">{{ lang_label }}</text>

  <!-- Node indicator -->
  <text x="837" y="48"
        font-family="Arial,sans-serif"
        font-size="9" fill="#6A5F52" letter-spacing="2"
        text-anchor="middle" opacity=".42">{{ node }}</text>

  <!-- Masthead: COMA.FM -->
  <text x="80" y="132"
        font-family="Arial,sans-serif"
        font-size="13" fill="#6A5F52" letter-spacing="9" font-weight="700">COMA.FM</text>

  <!-- Masthead: RADAR -->
  <text x="78" y="220"
        font-family="'Arial Black',Impact,Arial,sans-serif"
        font-size="80" fill="#1F2523" letter-spacing="-3">RADAR</text>

  <!-- Masthead separator -->
  <line x1="80" y1="244" x2="820" y2="244" stroke="#1F2523" stroke-width="1.5" opacity=".28"/>

  <!-- Ghost atmosphere — faint scan register lines across composition zone -->
  <line x1="80" y1="302" x2="820" y2="302" stroke="#6A5F52" stroke-width="0.5" opacity=".04"/>
  <line x1="80" y1="402" x2="820" y2="402" stroke="#6A5F52" stroke-width="0.5" opacity=".04"/>
  <line x1="80" y1="502" x2="820" y2="502" stroke="#6A5F52" stroke-width="0.5" opacity=".03"/>
  <line x1="80" y1="602" x2="820" y2="602" stroke="#6A5F52" stroke-width="0.5" opacity=".03"/>
  <line x1="80" y1="702" x2="820" y2="702" stroke="#6A5F52" stroke-width="0.5" opacity=".04"/>

  <!-- Ghost transmission residue — echo of TX identity at low opacity -->
  <text x="450" y="685"
        font-family="Arial,sans-serif"
        font-size="10" fill="#6A5F52" letter-spacing="4"
        text-anchor="middle" opacity=".05">{{ tx_code }}</text>

  <!-- ═══ Mode-specific geometric composition ═══ -->

  {% if cover_mode == "concentric" %}
  {% for arc in cover_arcs %}
  <circle cx="{{ cover_cx }}" cy="{{ cover_cy }}" r="{{ arc.r }}"
          fill="none" stroke="{{ accent }}" stroke-width="{{ arc.sw }}"
          opacity="{{ arc.opacity }}"/>
  {% endfor %}
  <circle cx="{{ cover_cx }}" cy="{{ cover_cy }}" r="{{ cover_arc_r }}"
          fill="{{ accent }}" opacity=".16"/>
  <circle cx="{{ cover_cx }}" cy="{{ cover_cy }}" r="7"
          fill="{{ accent }}" opacity=".40"/>
  <line x1="{{ cover_cx }}" y1="254" x2="{{ cover_cx }}" y2="720"
        stroke="#6A5F52" stroke-width="0.5" opacity=".18"/>
  <line x1="80" y1="{{ cover_cy }}" x2="820" y2="{{ cover_cy }}"
        stroke="#6A5F52" stroke-width="0.5" opacity=".12"/>
  {% endif %}

  {% if cover_mode == "frequency_bars" %}
  {% for bar in cover_bars %}
  <rect x="{{ bar.x }}" y="{{ bar.y }}" width="{{ bar.w }}" height="{{ bar.h }}"
        fill="{{ accent }}" opacity=".18"/>
  {% endfor %}
  <line x1="80" y1="675" x2="820" y2="675"
        stroke="#6A5F52" stroke-width="1" opacity=".28"/>
  {% endif %}

  {% if cover_mode == "modular_skyline" %}
  {% for mod in cover_modules %}
  <rect x="{{ mod.x }}" y="{{ mod.y }}" width="{{ mod.w }}" height="{{ mod.h }}"
        fill="{{ accent }}" opacity=".15"/>
  {% endfor %}
  <line x1="60" y1="675" x2="840" y2="675"
        stroke="#6A5F52" stroke-width="1" opacity=".28"/>
  {% endif %}

  {% if cover_mode == "tuner_scale" %}
  <line x1="80" y1="542" x2="820" y2="542"
        stroke="{{ accent }}" stroke-width="2" opacity=".42"/>
  {% for tick in cover_ticks %}
  <line x1="{{ tick.x }}" y1="{{ tick.y1 }}" x2="{{ tick.x }}" y2="{{ tick.y2 }}"
        stroke="{{ accent }}" stroke-width="{{ tick.sw }}" opacity=".42"/>
  {% endfor %}
  {% for tick in cover_ticks %}
  <text x="{{ tick.x }}" y="{{ tick.text_y }}"
        font-family="Arial,sans-serif"
        font-size="10" fill="#6A5F52" letter-spacing="0"
        text-anchor="middle" opacity=".55">{{ tick.freq }}</text>
  {% endfor %}
  <line x1="{{ cover_needle_x }}" y1="488" x2="{{ cover_needle_x }}" y2="592"
        stroke="{{ accent_2 }}" stroke-width="2" opacity=".70"/>
  <circle cx="{{ cover_needle_x }}" cy="488" r="5"
          fill="{{ accent_2 }}" opacity=".70"/>
  <circle cx="{{ cover_needle_x }}" cy="488" r="55"
          fill="none" stroke="{{ accent_2 }}" stroke-width="1" opacity=".16"/>
  <circle cx="{{ cover_needle_x }}" cy="488" r="112"
          fill="none" stroke="{{ accent_2 }}" stroke-width="0.75" opacity=".10"/>
  <circle cx="{{ cover_needle_x }}" cy="488" r="172"
          fill="none" stroke="{{ accent_2 }}" stroke-width="0.5" opacity=".07"/>
  {% endif %}

  {% if cover_mode == "horizon_signal" %}
  {% for row in cover_horizon_rows %}
  <line x1="{{ row.x0 }}" y1="{{ row.y }}" x2="{{ row.x1 }}" y2="{{ row.y }}"
        stroke="{{ accent }}" stroke-width="{{ row.sw }}" opacity="{{ row.opacity }}"/>
  {% endfor %}
  {% endif %}

  <!-- TX code &#x2014; dominant broadcast identifier -->
  <text x="80" y="762"
        font-family="Arial,sans-serif"
        font-size="46" fill="{{ accent_2 }}" letter-spacing="4"
        font-weight="700" opacity=".82">{{ tx_code }}</text>

  <!-- Heavy composition rule -->
  <line x1="60" y1="800" x2="840" y2="800" stroke="#1F2523" stroke-width="8"/>

  <!-- Issue date -->
  <text x="80" y="844"
        font-family="Arial,sans-serif"
        font-size="20" fill="{{ accent }}" letter-spacing="6">{{ issue_date }}</text>

  <!-- Main tag label -->
  <rect x="78" y="860" width="{{ tag_pill_width }}" height="31" rx="0"
        fill="{{ accent }}" opacity=".11"/>
  <text x="84" y="881"
        font-family="Arial,sans-serif"
        font-size="14" fill="{{ accent }}" letter-spacing="4" font-weight="700">{{ main_tag_label }}</text>

  <!-- Frequency instrumentation scale &#x2014; 88&#x2013;108 FM -->
  <line x1="80" y1="906" x2="820" y2="906"
        stroke="#6A5F52" stroke-width="0.75" opacity=".32"/>
  <line x1="80"  y1="902" x2="80"  y2="910" stroke="#6A5F52" stroke-width="0.75" opacity=".42"/>
  <line x1="228" y1="902" x2="228" y2="908" stroke="#6A5F52" stroke-width="0.5"  opacity=".32"/>
  <line x1="376" y1="902" x2="376" y2="910" stroke="#6A5F52" stroke-width="0.75" opacity=".42"/>
  <line x1="524" y1="902" x2="524" y2="908" stroke="#6A5F52" stroke-width="0.5"  opacity=".32"/>
  <line x1="672" y1="902" x2="672" y2="910" stroke="#6A5F52" stroke-width="0.75" opacity=".42"/>
  <line x1="820" y1="902" x2="820" y2="910" stroke="#6A5F52" stroke-width="0.75" opacity=".42"/>
  <text x="80"  y="924" font-family="Arial,sans-serif" font-size="9" fill="#6A5F52" text-anchor="middle" opacity=".52">88</text>
  <text x="376" y="924" font-family="Arial,sans-serif" font-size="9" fill="#6A5F52" text-anchor="middle" opacity=".52">96</text>
  <text x="672" y="924" font-family="Arial,sans-serif" font-size="9" fill="#6A5F52" text-anchor="middle" opacity=".52">104</text>
  <text x="820" y="924" font-family="Arial,sans-serif" font-size="9" fill="#6A5F52" text-anchor="middle" opacity=".52">108</text>

  <!-- Node and band -->
  <text x="80" y="952"
        font-family="Arial,sans-serif"
        font-size="10" fill="#6A5F52" letter-spacing="3" opacity=".52">NODE {{ node }} &#xB7; BAND {{ band }}</text>

  <!-- Item count and lang -->
  <text x="80" y="974"
        font-family="Arial,sans-serif"
        font-size="10" fill="#6A5F52" letter-spacing="2" opacity=".48">{{ item_count }} items &#xB7; {{ lang_label }} &#xB7; FIELD REPORT</text>

  {% if subtitle %}
  <text x="80" y="1028"
        font-family="Georgia,serif"
        font-size="16" fill="#6A5F52" font-style="italic" opacity=".60">{{ subtitle }}</text>
  {% endif %}

</svg>
